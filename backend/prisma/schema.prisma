// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. Generic Table
// ==========================================
model Generic {
  id          Int         @id @default(autoincrement())
  name        String      @unique // A-Z name
  inventories Inventory[]

  @@map("generic_tbl")
}

// ==========================================
// 2. Category Table
// ==========================================
model Category {
  id           Int                       @id @default(autoincrement())
  name         String                    @unique // A-Z name
  inventories  Inventory[]
  salesReports CategoryWiseSalesReport[]

  @@map("category_tbl")
}

// ==========================================
// 3. Rack Table
// ==========================================
model Rack {
  id          Int         @id @default(autoincrement())
  name        String      @unique // A-Z name
  description String? // A-Z description
  inventories Inventory[]

  @@map("rack_tbl")
}

// ==========================================
// 4. Inventory Table
// ==========================================
model DistributorReturn {
  id              Int         @id @default(autoincrement())
  distributorId   Int         @map("distributor_id")
  distributor     Distributor @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  debitNoteNumber String      @unique @map("debit_note_number")
  date            DateTime    @map("return_date")
  items           Json
  totalAmount     Decimal     @map("total_amount") @db.Decimal(12, 2)
  notes           String?     @map("notes")
  createdAt       DateTime    @default(now()) @map("created_at")

  @@index([distributorId])
  @@index([date])
  @@map("distributor_returns_tbl")
}

model Inventory {
  id            Int    @id @default(autoincrement())
  medicineBrand String @map("medicine_brand") // A-Z medicine_brand
  batchNumber   String @map("batch_number") // A-Z batch_number
  expiryDate    String @map("expiry_date") // expiry_date

  // Foreign Keys
  genericId Int     @map("generic_id")
  generic   Generic @relation(fields: [genericId], references: [id], onDelete: Restrict)

  categoryId Int      @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  rackId Int?  @map("rack_id")
  rack   Rack? @relation(fields: [rackId], references: [id], onDelete: SetNull)

  distributorId Int?         @map("distributor_id")
  distributor   Distributor? @relation(fields: [distributorId], references: [id], onDelete: SetNull)

  // Quantities
  unitPerPack    Int @default(10) @map("unit_per_pack")
  packInStock    Int @default(0) @map("pack_in_stock")
  unitInStock    Int @default(0) @map("unit_in_stock")
  packAlertLevel Int @default(15) @map("pack_alert_level")

  // Pricing
  costPrice    Decimal @map("cost_price") @db.Decimal(10, 2)
  sellingPrice Decimal @map("selling_price") @db.Decimal(10, 2)

  // Statutory VAT
  hasvat Boolean @default(false) @map("hasvat")

  // Optional medicine metadata
  barcode String? @map("barcode")
  notes   String? @map("notes")

  // Relations
  billItems            BillItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  salesReturnItems     SalesReturnItem[]
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  stockAdjustmentLogs StockAdjustmentLog[]

  @@unique([medicineBrand, batchNumber], map: "inventory_medicine_batch_unique")
  @@index([medicineBrand])
  @@index([genericId])
  @@index([categoryId])
  @@index([rackId])
  @@index([batchNumber])
  @@index([distributorId])
  @@map("inventory_tbl")
}

// ==========================================
// 5. User Table
// ==========================================
model User {
  id          String   @id @default(cuid())
  username    String   @unique @map("username")
  password    String   @map("password") // Hashed password
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  initials    String?  @map("initials")
  email       String?  @map("email")
  phoneNumber String?  @map("phone_number")
  role        String   @default("staff") @map("role") // "admin" | "staff"
  shift       String?  @map("shift")
  status      String   @default("active") @map("status")
  createdAt   DateTime @default(now()) @map("created_at")

  bills        Bill[]
  clinicVisits ClinicVisit[]

  @@map("user_tbl")
}

// ==========================================
// 6. Bill / Invoice Table
// ==========================================
model Bill {
  id                Int      @id @default(autoincrement())
  invoiceNumber     String   @unique @map("invoice_number")
  clientRequestId   String?  @unique(map: "bill_tbl_client_request_id_key") @map("client_request_id")
  transactionDate   DateTime @default(now()) @map("transaction_date")
  customerName      String?  @map("customer_name")
  customerPhone     String?  @map("customer_phone")
  customerPan       String?  @map("customer_pan")
  prescribingDoctor String?  @map("prescribing_doctor")
  paymentMethod     String   @default("cash") @map("payment_method")
  paymentStatus     String   @default("paid") @map("payment_status")

  // Financial amounts
  subTotal       Decimal @map("sub_total") @db.Decimal(12, 2)
  discountAmount Decimal @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  vatAmount      Decimal @default(0.00) @map("vat_amount") @db.Decimal(12, 2)
  grandTotal     Decimal @map("grand_total") @db.Decimal(12, 2)
  amountReceived Decimal @default(0.00) @map("amount_received") @db.Decimal(12, 2)
  changeReturned Decimal @default(0.00) @map("change_returned") @db.Decimal(12, 2)

  // Cashier Foreign Key
  cashierId String @map("cashier_id")
  cashier   User   @relation(fields: [cashierId], references: [id], onDelete: Restrict)

  // Line items
  items BillItem[]

  salesReturns SalesReturn[]

  @@index([invoiceNumber])
  @@index([transactionDate])
  @@index([cashierId])
  @@map("bill_tbl")
}

// ==========================================
// 7. Bill Line Items Table
// ==========================================
model BillItem {
  id Int @id @default(autoincrement())

  // Foreign Keys
  invoiceId Int  @map("invoice_id")
  invoice   Bill @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  inventoryId Int       @map("inventory_id")
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  // Quantities sold
  quantityInPack Int @default(0) @map("quantity_in_pack")
  quantityInUnit Int @default(0) @map("quantity_in_unit")

  // Prices
  packPrice      Decimal @map("pack_price") @db.Decimal(10, 2)
  vatitemPrice   Decimal @default(0.00) @map("vatitem_price") @db.Decimal(12, 2)
  grossItemPrice Decimal @map("gross_item_price") @db.Decimal(12, 2)
  netItemPrice   Decimal @map("net_item_price") @db.Decimal(12, 2)

  // Immutable sale-time snapshots. These protect historical invoices and
  // credit notes from later edits to the live Inventory row. Existing rows
  // remain nullable and fall back to the legacy relation when necessary.
  medicineNameSnapshot String?  @map("medicine_name_snapshot")
  genericNameSnapshot  String?  @map("generic_name_snapshot")
  categoryNameSnapshot String?  @map("category_name_snapshot")
  batchNumberSnapshot  String?  @map("batch_number_snapshot")
  expiryDateSnapshot   String?  @map("expiry_date_snapshot")
  unitsPerPackSnapshot Int?     @map("units_per_pack_snapshot")
  costPriceSnapshot    Decimal? @map("cost_price_snapshot") @db.Decimal(10, 2)
  hasVatSnapshot       Boolean? @map("has_vat_snapshot")
  rackLocationSnapshot String?  @map("rack_location_snapshot")

  salesReturnItems SalesReturnItem[]

  @@index([invoiceId])
  @@index([inventoryId])
  @@map("bill_items")
}

// ==========================================
// 8. Category Wise Sales Report Table
// ==========================================
model CategoryWiseSalesReport {
  id Int @id @default(autoincrement())

  categoryId Int      @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  medicineCount Int @default(0) @map("medicine_count")
  packetsCount  Int @default(0) @map("packets_count")
  unitsCount    Int @default(0) @map("units_count")

  costValuation Decimal @default(0.00) @map("cost_valuation") @db.Decimal(12, 2)
  saleValuation Decimal @default(0.00) @map("sale_valuation") @db.Decimal(12, 2)
  grossMargin   Decimal @default(0.00) @map("gross_margin") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([categoryId])
  @@map("category_wise_sales_report_tbl")
}

// ==========================================
// 9. Distributors Table
// ==========================================
model Distributor {
  id             Int      @id @default(autoincrement())
  name           String   @map("name")
  pannumber      String?  @map("pannumber")
  phone          String   @map("phone")
  email          String?  @map("email")
  address        String?  @map("address")
  contactPerson  String?  @map("contact_person")
  creditLimit    Decimal  @default(0.00) @map("credit_limit") @db.Decimal(12, 2)
  currentBalance Decimal  @default(0.00) @map("current_balance") @db.Decimal(12, 2)
  notes          String?  @map("notes")
  status         String   @default("active") @map("status")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  ledgers     Ledger[]
  inventories Inventory[]
  purchases   PurchaseInvoice[]
  returns     DistributorReturn[]

  @@map("distributors_tbl")
}

// ==========================================
// 10. Ledger Table
// ==========================================
model Ledger {
  id Int @id @default(autoincrement())

  distributorId Int?         @map("distributor_id")
  distributor   Distributor? @relation(fields: [distributorId], references: [id], onDelete: SetNull)

  invoiceId      Int?     @map("invoice_id")
  dateOfCreation DateTime @default(now()) @map("date_of_creation")
  description    String?  @map("description")
  ledgerType     String   @map("ledger_type") // e.g. "purchase", "payment", "return"
  referenceNo    String?  @map("reference_no")

  debitAmount  Decimal @default(0.00) @map("debit_amount") @db.Decimal(12, 2)
  creditAmount Decimal @default(0.00) @map("credit_amount") @db.Decimal(12, 2)
  balance      Decimal @default(0.00) @map("balance") @db.Decimal(12, 2)

  @@index([distributorId])
  @@index([dateOfCreation])
  @@map("ledger_tbl")
}

model StockAdjustmentLog {
  id                 Int      @id @default(autoincrement())
  medicineId         Int
  adjustmentType     String
  previousPacks      Int
  newPacks           Int
  variancePacks      Int
  previousLooseUnits Int
  newLooseUnits      Int
  varianceLooseUnits Int
  reason             String
  recordedBy         String
  createdAt          DateTime @default(now())

  medicine Inventory @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@index([medicineId])
  @@index([createdAt])
  @@map("stock_adjustment_logs_tbl")
}

// ==========================================
// 12. Purchase Invoices (Inward Stock Bills)
// ==========================================
model PurchaseInvoice {
  id            Int         @id @default(autoincrement())
  invoiceNumber String      @map("invoice_number") // Wholesaler invoice/bill number
  distributorId Int         @map("distributor_id")
  distributor   Distributor @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  purchaseDate  DateTime    @default(now()) @map("purchase_date")
  paymentMode   String      @default("credit") @map("payment_mode") // "credit" | "cash"
  dueDate       DateTime?   @map("due_date")

  // Financial amounts
  subtotal       Decimal  @map("subtotal") @db.Decimal(12, 2)
  discountAmount Decimal  @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  taxableAmount  Decimal  @default(0.00) @map("taxable_amount") @db.Decimal(12, 2)
  vatAmount      Decimal  @default(0.00) @map("vat_amount") @db.Decimal(12, 2)
  grandTotal     Decimal  @map("grand_total") @db.Decimal(12, 2)
  notes          String?  @map("notes")
  createdAt      DateTime @default(now()) @map("created_at")

  items PurchaseInvoiceItem[]

  @@unique([distributorId, invoiceNumber], map: "purchase_invoice_supplier_invoice_unique")
  @@index([invoiceNumber])
  @@index([distributorId])
  @@index([purchaseDate])
  @@map("purchase_invoice_tbl")
}

// ==========================================
// 13. Purchase Invoice Items
// ==========================================
model PurchaseInvoiceItem {
  id        Int             @id @default(autoincrement())
  invoiceId Int             @map("invoice_id")
  invoice   PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  inventoryId Int?       @map("inventory_id")
  inventory   Inventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)

  medicineName String  @map("medicine_name")
  genericName  String? @map("generic_name")
  categoryName String? @map("category_name")
  batchNumber  String  @map("batch_number")
  expiryDate   String  @map("expiry_date")

  packQty      Int @map("pack_qty")
  looseUnits   Int @default(0) @map("loose_units")
  freePacks    Int @default(0) @map("free_packs")
  unitsPerPack Int @default(10) @map("units_per_pack")

  costPrice       Decimal @map("cost_price") @db.Decimal(10, 2)
  discountPercent Decimal @default(0.00) @map("discount_percent") @db.Decimal(5, 2)
  isVatApplicable Boolean @default(false) @map("is_vat_applicable")
  mrpPrice        Decimal @map("mrp_price") @db.Decimal(10, 2)
  rackLocation    String? @map("rack_location")
  lineTotal       Decimal @map("line_total") @db.Decimal(12, 2)

  @@index([invoiceId])
  @@index([inventoryId])
  @@map("purchase_invoice_items_tbl")
}

// ==========================================
// 14. Pharmacy Store Settings
// ==========================================
model PharmacySetting {
  id                         Int      @id @default(autoincrement())
  storeName                  String   @default("Prakash Pharmacy") @map("store_name")
  address                    String   @default("") @map("address")
  phoneNumber                String   @default("") @map("phone_number")
  emailId                    String   @default("") @map("email_id")
  panNumber                  String   @default("") @map("pan_number")
  ddaLicenceNumber           String   @default("") @map("dda_licence_number")
  vatRegistered              Boolean  @default(true) @map("vat_registered")
  storeLogo                  String?  @map("store_logo") @db.Text
  pharmacistName             String   @default("") @map("pharmacist_name")
  pharmacistCouncilRegNumber String   @default("") @map("pharmacist_council_reg_number")
  ddaLicenceExpiryDate       String   @default("") @map("dda_licence_expiry_date")
  currency                   String   @default("NPR") @map("currency")
  fiscalYear                 String   @default("2081/82") @map("fiscal_year")
  invoicePrefix              String   @default("PP-2081/82-") @map("invoice_prefix")
  nextInvoiceNumber          Int      @default(101) @map("next_invoice_number")
  nextCreditNoteNumber       Int      @default(1) @map("next_credit_note_number")
  defaultInvoiceSize         String   @default("A5") @map("default_invoice_size")
  invoiceDateFormat          String   @default("BS") @map("invoice_date_format")
  receiptFooterNote          String   @default("Thank you for your visit. Medicines once sold cannot be returned without original bill.") @map("receipt_footer_note")
  defaultLowStockThreshold   Int      @default(15) @map("default_low_stock_threshold")
  nearExpiryThresholdMonths  Int      @default(6) @map("near_expiry_threshold_months")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@map("pharmacy_settings_tbl")
}

// ==========================================
// 15. Clinic / OPD Doctors
// ==========================================
model Doctor {
  id                     Int      @id @default(autoincrement())
  name                   String   @map("name")
  speciality             String?  @map("speciality")
  qualification          String?  @map("qualification")
  nmcNumber              String?  @unique @map("nmc_number")
  defaultConsultationFee Decimal  @default(0.00) @map("default_consultation_fee") @db.Decimal(12, 2)
  status                 String   @default("active") @map("status")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  visits ClinicVisit[]

  @@index([name])
  @@index([status])
  @@map("clinic_doctors_tbl")
}

// ==========================================
// 16. Clinic / OPD Patients
// ==========================================
model ClinicPatient {
  id        Int      @id @default(autoincrement())
  name      String   @map("name")
  phone     String?  @map("phone")
  gender    String?  @map("gender")
  ageYears  Int?     @map("age_years")
  address   String?  @map("address")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  visits ClinicVisit[]

  @@index([name])
  @@index([phone])
  @@map("clinic_patients_tbl")
}

// ==========================================
// 17. Clinic / OPD Visits
// ==========================================
model ClinicVisit {
  id Int @id @default(autoincrement())

  patientId Int           @map("patient_id")
  patient   ClinicPatient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  doctorId Int    @map("doctor_id")
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  createdById String? @map("created_by_id")
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  visitDateTime DateTime @default(now()) @map("visit_date_time")

  // Snapshot of age when this particular OPD visit occurred.
  ageAtVisit Int? @map("age_at_visit")

  // Consultation amount recorded when the patient arrives.
  consultationFee Decimal @default(0.00) @map("consultation_fee") @db.Decimal(12, 2)

  // Extra clinic/procedure amount added after consultation.
  additionalCharge Decimal @default(0.00) @map("additional_charge") @db.Decimal(12, 2)

  // Optional explanation for the additional amount.
  additionalChargeNote String? @map("additional_charge_note")

  // Final clinic revenue for this OPD visit.
  // OPEN: normally consultationFee only.
  // COMPLETED: consultationFee + additionalCharge.
  totalCharge Decimal @default(0.00) @map("total_charge") @db.Decimal(12, 2)

  // Kept temporarily for backward compatibility with the first OPD version.
  chargeNote String? @map("charge_note")

  // Existing historical visits become completed when this column is introduced.
  // New registrations explicitly set this to "open".
  status String @default("completed") @map("status")

  completedAt DateTime? @map("completed_at")

  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @map("cancel_reason")

  voidedAt   DateTime? @map("voided_at")
  voidReason String?   @map("void_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([patientId])
  @@index([doctorId])
  @@index([createdById])
  @@index([visitDateTime])
  @@map("clinic_visits_tbl")
}

// ==========================================
// 18. Customer Sales Returns / Credit Notes
// ==========================================
model SalesReturn {
  id               Int    @id @default(autoincrement())
  creditNoteNumber String @unique @map("credit_note_number")
  invoiceId        Int    @map("invoice_id")
  invoice          Bill   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  returnDate   DateTime @default(now()) @map("return_date")
  refundAmount Decimal  @default(0.00) @map("refund_amount") @db.Decimal(12, 2)
  reason       String?  @map("reason")
  recordedBy   String?  @map("recorded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  items SalesReturnItem[]

  @@index([invoiceId])
  @@index([returnDate])
  @@map("sales_returns_tbl")
}

model SalesReturnItem {
  id          Int         @id @default(autoincrement())
  returnId    Int         @map("return_id")
  salesReturn SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  billItemId Int      @map("bill_item_id")
  billItem   BillItem @relation(fields: [billItemId], references: [id], onDelete: Restrict)

  inventoryId Int       @map("inventory_id")
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  quantityInPack Int     @default(0) @map("quantity_in_pack")
  quantityInUnit Int     @default(0) @map("quantity_in_unit")
  refundAmount   Decimal @default(0.00) @map("refund_amount") @db.Decimal(12, 2)

  @@index([returnId])
  @@index([billItemId])
  @@index([inventoryId])
  @@map("sales_return_items_tbl")
}
