# Server Port (default 4000)
PORT=4000

# Environment Mode: "development" | "production"
NODE_ENV=development

# Allowed Frontend URLs for CORS
FRONTEND_URL=http://localhost:3000
# Additional CORS origins (comma-separated, optional)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/prakash_pharmacy?schema=public"

# Secret key used to sign and verify JSON Web Tokens (JWT)
JWT_SECRET="replace-this-with-a-long-random-secret"

# Optional: Initial Administrator Credentials for `npm run seed`
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
SEED_ADMIN_EMAIL=
